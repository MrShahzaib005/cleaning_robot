<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo reference="base_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="uper_body"><material>Gazebo/White</material></gazebo>
  <gazebo reference="red_uper_body"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="2nd_white_uper_body"><material>Gazebo/White</material></gazebo>
  <gazebo reference="front_right_wheel"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="front_left_wheel"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="back_left_wheel"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="back_right_wheel"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="camera"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="lidar"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="imu_link"><material>Gazebo/Black</material></gazebo>

  <!-- ==================== LIDAR PLUGIN ==================== -->
  <gazebo reference="lidar">
    <sensor name="rplidar_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="rplidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== IMX-500 CAMERA ==================== -->
  <gazebo reference="camera">
    <sensor name="imx500_camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <camera name="imx500">
        <horizontal_fov>1.1519</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>1.5</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/image_raw</remapping>
          <remapping>camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>imx500</camera_name>
        <frame_name>camera_optical</frame_name>
        <hack_baseline>0.0</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== IMU PLUGIN ==================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>70</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=/imu/data</remapping></ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================== WHEEL FRICTION ==================== -->
  <gazebo reference="front_right_wheel">
    <mu1>10.0</mu1><mu2>10.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth><fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="front_left_wheel">
    <mu1>10.0</mu1><mu2>10.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth><fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="back_right_wheel">
    <mu1>10.0</mu1><mu2>10.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth><fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="back_left_wheel">
    <mu1>10.0</mu1><mu2>10.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth><fdir1>1 0 0</fdir1>
  </gazebo>

  

  <gazebo reference="front_right_ultrasonic">
    <sensor name="front_right_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="front_right_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/front_right</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>front_right_ultrasonic</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="front_left_ultrasonic">
    <sensor name="front_left_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="front_left_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/front_left</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>front_left_ultrasonic</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="back_right_ultrasonic">
    <sensor name="back_right_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="back_right_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/back_right</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>back_right_ultrasonic</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="back_left_ultrasonic">
    <sensor name="back_left_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="back_left_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/back_left</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>back_left_ultrasonic</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="rightside_front_ultrasonic">
    <sensor name="rightside_front_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="rightside_front_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/rightside_front</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>rightside_front_ultrasonic</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="rightside_back_ultrasonic">
    <sensor name="rightside_back_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="rightside_back_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/rightside_back</remapping></ros>
