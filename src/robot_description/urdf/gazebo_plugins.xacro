      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="leftside_front_ultrasonic">
    <sensor name="leftside_front_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="leftside_front_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/leftside_front</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>leftside_front_ultrasonic</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="leftside_back_ultrasonic">
    <sensor name="leftside_back_ultrasonic_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.05</min_angle><max_angle>0.05</max_angle></horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="leftside_back_ultrasonic_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/ultrasonic/leftside_back</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>leftside_back_ultrasonic</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=/joint_states</remapping></ros>
      <update_rate>20</update_rate>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>back_left_wheel_joint</joint_name>
      <joint_name>back_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="mecanum_controller" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  
  <gazebo reference="depth_camera">
    <material>Gazebo/DarkGrey</material>
    <sensor name="aurora930_depth" type="depth">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <camera name="aurora930">
        <horizontal_fov>1.5184</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.3</near><far>8.0</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </camera>
      <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/depth_camera/image_raw</remapping>
          <remapping>image_depth:=/depth_camera/depth/image_raw</remapping>
          <remapping>camera_info:=/depth_camera/camera_info</remapping>
          <remapping>points:=/depth_camera/points</remapping>
        </ros>
        <camera_name>aurora930</camera_name>
        <frame_name>depth_camera_optical</frame_name>
        <hack_baseline>0.0</hack_baseline>
        <min_depth>0.3</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
